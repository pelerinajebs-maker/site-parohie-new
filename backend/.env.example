# MongoDB Atlas
# Obțineți de la: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://admin_parohia:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/parohia_db?retryWrites=true&w=majority
DB_NAME=parohia_db

# JWT Secret - GENERAȚI O VALOARE SECURIZATĂ (min 32 caractere)!
# Puteți folosi: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-change-this-min-32-chars

# Environment (development or production)
ENV=production

# CORS - domeniile permise să comunice cu API-ul
CORS_ORIGINS=http://localhost:3000,https://parohiasigmir.ro,https://www.parohiasigmir.ro

# Admin Account - SCHIMBAȚI ACESTE VALORI!
# Acestea vor fi credențiale inițiale pentru login
ADMIN_EMAIL=admin@parohiasigmir.ro
ADMIN_PASSWORD=your-secure-password-min-12-chars

# Stripe API Keys - Din Stripe Dashboard (https://dashboard.stripe.com)
# Folosiți Secret Key (sk_live_... pentru production, sk_test_... pentru testing)
STRIPE_API_KEY=sk_live_your_stripe_secret_key_here

# Stripe Webhook Secret - Din Stripe Dashboard → Webhooks
# Obțineți după ce adăugați webhook endpoint: https://your-backend.com/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_live_your_webhook_secret_here

# Emergent Email Integration
# Obțineți de la portal-ul Emergent (emergent.sh)
EMERGENT_EMAIL_KEY=your_emergent_email_key_here
EMAIL_FROM_NAME=Parohia Sigmir

# Email de contact pentru reply-to
ADMIN_EMAIL=contact@parohiasigmir.ro

